{
  "name": "Dispatcharr Codespace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {
      "version": "latest",
      "moby": true
    }
  },
  // NOTE: The devcontainer previously attempted to enable docker-in-docker features.
  // Some environments (or unauthenticated GHCR access) can fail processing these features.
  // If you want automatic Docker support inside the container, enable Docker-in-Codespaces
  // or configure a remote Docker host manually. Alternatively you can bind the host
  // Docker socket into the container using runArgs, e.g.:
  // "runArgs": ["-v", "/var/run/docker.sock:/var/run/docker.sock"]
  // or use the devcontainers/features entries if your environment supports GHCR access.

  // To connect to a remote Docker host, set the DOCKER_HOST environment variable.
  // Replace `tcp://localhost:2375` with the address of your remote Docker daemon.
  "containerEnv": {
    "DOCKER_HOST": "tcp://localhost:2375"
  },
  "forwardPorts": [9191, 5656, 8001, 3001, 6379],
  "workspaceFolder": "/workspace",
  "postCreateCommand": "python -m pip install --upgrade pip setuptools wheel && pip install -r requirements.txt || true && (cd frontend && npm ci) || true",
  "remoteUser": "vscode"
}
