{
  "name": "Dispatcharr Codespace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker": {},
    "ghcr.io/devcontainers/features/docker-cli": {}
  },
  // If your environment requires privileged mode for Docker-in-Docker, uncomment runArgs below
  // "runArgs": [
  //   "--privileged"
  // ],
  "forwardPorts": [9191, 5656, 8001, 3001, 6379],
  "workspaceFolder": "/workspace",
  "postCreateCommand": "python -m pip install --upgrade pip setuptools wheel && pip install -r requirements.txt || true && (cd frontend && npm ci) || true",
  "remoteUser": "vscode"
}
